{
  "info": {
    "name": "Teacher Session Booking API",
    "_postman_id": "b7f3c9a1-4e2d-4d8b-9f1a-2c3d4e5f6a7b",
    "description": "Collection for testing the Teacher Session Booking REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "teacherId", "value": "", "type": "string" },
    { "key": "sessionId", "value": "", "type": "string" },
    { "key": "dateTimestamp", "value": "2026-11-20T00:00:00.000Z", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Verify the API is running."
      },
      "response": []
    },
    {
      "name": "Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.data && json.data.id) {",
              "  pm.collectionVariables.set('userId', json.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"phone\": \"+1234567890\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        },
        "description": "Create a new user. Email must be unique. Saves the created user id to the `userId` collection variable."
      },
      "response": []
    },
    {
      "name": "Create Teacher (Helper)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.data && json.data.id) {",
              "  pm.collectionVariables.set('teacherId', json.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Dr. Alice Smith\",\n  \"email\": \"alice.smith@example.com\",\n  \"specialization\": \"Mathematics\",\n  \"experience\": 8\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/teachers",
          "host": ["{{baseUrl}}"],
          "path": ["teachers"]
        },
        "description": "Helper endpoint to create a teacher for testing. Saves the created teacher id to the `teacherId` collection variable."
      },
      "response": []
    },
    {
      "name": "Create Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.data && json.data.id) {",
              "  pm.collectionVariables.set('sessionId', json.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"2026-11-20T10:00:00.000Z\",\n  \"endTime\": \"2026-11-20T11:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions",
          "host": ["{{baseUrl}}"],
          "path": ["sessions"]
        },
        "description": "Create a new session for an existing teacher. Default status is AVAILABLE. Saves the created session id to the `sessionId` collection variable."
      },
      "response": []
    },
    {
      "name": "Get Available Sessions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "available"],
          "query": [
            {
              "key": "dateTimestamp",
              "value": "{{dateTimestamp}}",
              "description": "ISO 8601 date-time or epoch milliseconds. Sessions on the same UTC calendar day are returned."
            }
          ]
        },
        "description": "Return all AVAILABLE sessions for the supplied UTC date (implemented using a MongoDB aggregation pipeline)."
      },
      "response": []
    },
    {
      "name": "Book Session",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "book"]
        },
        "description": "Book an AVAILABLE session for a user. The session must exist, the user must exist, and the session must not already be booked."
      },
      "response": []
    },
    {
      "name": "Complete Session",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "complete"]
        },
        "description": "Mark a BOOKED session as COMPLETED and set completedAt."
      },
      "response": []
    },
    {
      "name": "Get User Sessions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}/sessions",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userId}}", "sessions"]
        },
        "description": "Return all sessions for the user separated into upcomingSessions and completedSessions (implemented using a MongoDB aggregation pipeline)."
      },
      "response": []
    }
  ]
}
